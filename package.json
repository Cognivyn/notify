{
  "name": "@cognivyn/notify",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Cognivyn unified notification channel connection system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sms": {
      "types": "./dist/sms.d.ts",
      "import": "./dist/sms.js",
      "default": "./dist/sms.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "import": "./dist/email.js",
      "default": "./dist/email.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp.d.ts",
      "import": "./dist/whatsapp.js",
      "default": "./dist/whatsapp.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "import": "./dist/push.js",
      "default": "./dist/push.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js",
      "default": "./dist/auth.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js",
      "default": "./dist/service.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "import": "./dist/builder.js",
      "default": "./dist/builder.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js",
      "default": "./dist/queue.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build && tsup",
    "prepublishOnly": "tsup",
    "dev": "turbo run dev",
    "test": "bun test ./packages/... tests/...",
    "test:coverage": "bun test --coverage ./packages/...",
    "lint": "eslint packages --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "type-check": "turbo run type-check && tsrs --noEmit",
    "clean": "turbo run clean && rm -rf dist"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "bun-types": "^1.4.2",
    "eslint": "^10.15.0",
    "prettier": "^3.3.3",
    "tsrs": "7.1.0-beta.tsrs4",
    "tsup": "^9.0.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
