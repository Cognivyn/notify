{
  "name": "@cognivyn/notify",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Cognivyn unified notification channel connection system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "dev": "turbo run dev",
    "test": "bun test ./packages/...",
    "test:coverage": "bun test --coverage ./packages/...",
    "lint": "eslint packages --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "type-check": "turbo run type-check && tsc --noEmit",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "bun-types": "^1.4.4",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@cognivyn/types": "workspace:*",
    "@cognivyn/config": "workspace:*",
    "@cognivyn/auth": "workspace:*",
    "@cognivyn/core": "workspace:*",
    "@cognivyn/channels": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
