{
  "name": "@cognivyn/notify",
  "version": "0.1.0",
  "private": true,
  "description": "Cognivyn unified notification channel connection system",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "bun test ./packages/...",
    "test:coverage": "bun test --coverage ./packages/...",
    "lint": "eslint packages --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "bun-types": "^1.4.2",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3",
    "turbo": "^2.5.4",
    "typescript": "^5.6.3"
  },
  "engines": {
    "bun": ">=1.4.2"
  }
}
