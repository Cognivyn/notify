# Copy to .env and fill per channel

# SMS - Twilio
# SMS_TWILIO_API_KEY=

# SMS - MSG91
# MSG91_AUTH_KEY=
# MSG91_SENDER=
# MSG91_TEMPLATE_ID=
# MSG91_ROUTE=4
# MSG91_COUNTRY=91

# Email - Resend
# RESEND_API_KEY=

# Email - AWS SES
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# WhatsApp
# WHATSAPP_TOKEN=

# Push - Firebase Cloud Messaging (FCM)
# PUSH_FCM_SERVER_KEY=

# Push - Apple Push Notification Service (APNS)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_TOPIC=
