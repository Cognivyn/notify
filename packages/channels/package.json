{
  "name": "@notify/channels",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Channel implementations (sms, email, whatsapp, push)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./sms": {
      "types": "./dist/sms.d.ts",
      "bun": "./src/sms.ts",
      "import": "./dist/sms.js",
      "default": "./dist/sms.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "bun": "./src/email.ts",
      "import": "./dist/email.js",
      "default": "./dist/email.js"
    },
    "./whatsapp": {
      "types": "./dist/whatsapp.d.ts",
      "bun": "./src/whatsapp.ts",
      "import": "./dist/whatsapp.js",
      "default": "./dist/whatsapp.js"
    },
    "./push": {
      "types": "./dist/push.d.ts",
      "bun": "./src/push.ts",
      "import": "./dist/push.js",
      "default": "./dist/push.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@notify/types": "workspace:*",
    "@notify/config": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "clean": "rm -rf dist"
  }
}
