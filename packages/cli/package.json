{
  "name": "@cognivyn/cli",
  "version": "0.1.0",
  "license": "MIT",
  "description": "CLI for notify",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "notify": "./dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@cognivyn/types": "workspace:*",
    "@cognivyn/config": "workspace:*",
    "@cognivyn/auth": "workspace:*",
    "@cognivyn/core": "workspace:*",
    "@cognivyn/channels": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run ./src/index.ts --help",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "clean": "rm -rf dist"
  }
}
