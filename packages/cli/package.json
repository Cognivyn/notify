{
  "name": "@notify/cli",
  "version": "0.1.0",
  "description": "CLI for notify",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "notify": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@notify/types": "workspace:*",
    "@notify/config": "workspace:*",
    "@notify/auth": "workspace:*",
    "@notify/core": "workspace:*",
    "@notify/channels": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "bun run ./src/index.ts --help",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "clean": "rm -rf dist"
  }
}
