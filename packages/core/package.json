{
  "name": "@notify/core",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Core notification orchestration engine",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "bun": "./src/service.ts",
      "import": "./dist/service.js",
      "default": "./dist/service.js"
    },
    "./builder": {
      "types": "./dist/builder.d.ts",
      "bun": "./src/builder.ts",
      "import": "./dist/builder.js",
      "default": "./dist/builder.js"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "bun": "./src/queue.ts",
      "import": "./dist/queue.js",
      "default": "./dist/queue.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@notify/types": "workspace:*",
    "@notify/config": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "clean": "rm -rf dist"
  }
}
